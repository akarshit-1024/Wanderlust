
<% layout("/layouts/boilerplate") -%>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card border-0 shadow rounded-4 p-4 p-md-5">

        <div class="text-center mb-4">
          <i class="bi bi-check-circle-fill text-success"
             style="font-size: 75px;"></i>

          <h2 class="fw-bold mt-3">Booking Confirmed!</h2>

          <p class="text-secondary">
            Your reservation has been successfully created.
          </p>

          <span class="badge bg-success-subtle text-success fs-6">
            <%= booking.bookingStatus %>
          </span>
        </div>

        <hr>

        <h5 class="fw-bold mb-3">Reservation Details</h5>

        <% if (booking.listing) { %>
          <div class="d-flex gap-3 align-items-center mb-4">
            <img
              src="<%= booking.listing.image.url %>"
              style="width:120px;height:90px;object-fit:cover;"
              class="rounded-3"
              alt="Property"
            >

            <div>
              <h5 class="fw-bold mb-1">
                <%= booking.listing.title %>
              </h5>

              <p class="text-secondary mb-0">
                <i class="bi bi-geo-alt"></i>
                <%= booking.listing.country %>
              </p>
            </div>
          </div>
        <% } %>

        <div class="row g-3">

          <div class="col-md-6">
            <small class="text-secondary">Booking ID</small>
            <p class="fw-semibold mb-0">
              <%= booking._id %>
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Guests</small>
            <p class="fw-semibold mb-0">
              <%= booking.guests %> Guests
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Check-in</small>
            <p class="fw-semibold mb-0">
              <%= new Date(booking.checkIn).toLocaleDateString("en-IN") %>
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Check-out</small>
            <p class="fw-semibold mb-0">
              <%= new Date(booking.checkOut).toLocaleDateString("en-IN") %>
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Number of Nights</small>
            <p class="fw-semibold mb-0">
              <%= booking.nights %> Nights
            </p>
          </div>

          <div class="col-md-6">
            <small class="text-secondary">Payment Status</small>
            <p class="fw-semibold text-warning mb-0">
              <%= booking.paymentStatus %>
            </p>
          </div>

        </div>

        <hr>

        <h5 class="fw-bold mb-3">Payment Summary</h5>

        <div class="d-flex justify-content-between mb-2">
          <span>Price per night</span>
          <strong>₹<%= booking.pricePerNight.toLocaleString("en-IN") %></strong>
        </div>

        <div class="d-flex justify-content-between mb-2">
          <span><%= booking.nights %> Nights</span>
          <strong>
            ₹<%= (booking.pricePerNight * booking.nights).toLocaleString("en-IN") %>
          </strong>
        </div>

        <div class="d-flex justify-content-between mb-3">
          <span>Service Fee</span>
          <strong>₹<%= booking.serviceFee.toLocaleString("en-IN") %></strong>
        </div>

        <hr>

        <div class="d-flex justify-content-between fs-4 fw-bold">
          <span>Total Amount</span>
          <span class="text-primary">
            ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
          </span>
        </div>

        <div class="alert alert-info mt-4">
          <i class="bi bi-info-circle-fill me-2"></i>
          Your booking is confirmed. Payment is currently pending.
        </div>

        <div class="d-flex flex-column flex-md-row gap-3 mt-3">

          <a href="/booking/mybookings"
             class="btn btn-primary flex-fill">
            View My Bookings
          </a>

          <a href="/listinges"
             class="btn btn-outline-secondary flex-fill">
            Explore More Places
          </a>

        </div>

      </div>
    </div>
  </div>
</div>
